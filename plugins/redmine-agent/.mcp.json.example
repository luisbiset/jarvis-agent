{
  "mcpServers": {
    "redmine": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/scripts/server.mjs"
      ],
      "env_vars": [
        "REDMINE_API_KEY"
      ],
      "default_tools_approval_mode": "writes",
      "env": {
        "REDMINE_URL": "https://seu-redmine.example"
      }
    }
  }
}

