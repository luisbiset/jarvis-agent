{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jarvis://contracts/dashboard-integration/1.0.0",
  "title": "Dashboard Integration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "enabled", "capabilities", "authorization", "timeout_ms"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$"},
    "type": {"type": "string", "enum": ["MCP", "LOCAL_ADAPTER"]},
    "enabled": {"type": "boolean"},
    "capabilities": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,120}$"}, "uniqueItems": true},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["mode", "write_confirmation"], "properties": {"mode": {"type": "string", "enum": ["DENY_BY_DEFAULT", "READ_ONLY", "APPROVED"]}, "write_confirmation": {"type": "boolean"}}},
    "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 120000},
    "endpoint_ref": {"type": "string", "maxLength": 200},
    "audit": {"type": "boolean", "const": true}
  }
}
