{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "recall_at_k", "reciprocal_rank", "budget_compliant", "fallback_operational"],
  "properties": {
    "case_id": {"type": "string"},
    "recall_at_k": {"type": "number", "minimum": 0, "maximum": 1},
    "reciprocal_rank": {"type": "number", "minimum": 0, "maximum": 1},
    "budget_compliant": {"type": "boolean"},
    "fallback_operational": {"type": "boolean"}
  }
}
