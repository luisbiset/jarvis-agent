{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aghuse/execution-plan.schema.json",
  "type": "object",
  "required": ["strategy", "agents_planned", "teams_planned", "max_parallel_agents", "max_model_calls", "context_budget", "review_required", "retry_policy", "estimated_cost_class"],
  "properties": {
    "strategy": {"enum": ["MINIMAL_FIRST", "FIXED_CRITICAL", "ESCALATED"]},
    "agents_planned": {"type": "array", "items": {"type": "string"}},
    "teams_planned": {"type": "array", "items": {"type": "string"}},
    "max_parallel_agents": {"type": "integer", "minimum": 1},
    "max_model_calls": {"type": "integer", "minimum": 1},
    "context_budget": {"enum": ["SMALL", "MEDIUM", "LARGE"]},
    "review_required": {"type": "boolean"},
    "retry_policy": {"enum": ["NONE", "TARGETED", "ONE_ESCALATION"]},
    "estimated_cost_class": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "rag_available": {"type": "boolean"},
    "planner_version": {"type": "string"}
  },
  "additionalProperties": true
}
